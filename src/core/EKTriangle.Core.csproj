<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared logic. Compiled into EKTriangle.exe (net48, no dependencies) and tested on net8.0. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>EKTriangle.Core</AssemblyName>
    <RootNamespace>EKTriangle.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
