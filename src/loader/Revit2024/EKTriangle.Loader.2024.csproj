<Project Sdk="Microsoft.NET.Sdk">
  <!-- EK Triangle loader for Revit 2024 (net48), compiled against the Revit 2024 API. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EKTriangle</AssemblyName>
    <RootNamespace>EKTriangle.Loader</RootNamespace>
    <AssemblyTitle>EK Triangle loader for Revit 2024</AssemblyTitle>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\App.cs" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
