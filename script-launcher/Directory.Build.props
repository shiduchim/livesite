<Project>
  <!-- Shared settings for the four EK Script Launcher builds (Revit 2024-2027).
       Its own file, so the repository's EK Triangle settings do not apply here. -->
  <PropertyGroup>
    <Version>2.1.0</Version>
    <Company>EK</Company>
    <Product>EK Script Launcher</Product>
    <Copyright>Copyright (c) EK</Copyright>
    <AssemblyName>EKScriptLauncher</AssemblyName>
    <RootNamespace>EKScriptLauncher</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <PathMap>$(MSBuildThisFileDirectory)=.\</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src\**\*.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)src\Resources\*.png"
                      LogicalName="EKScriptLauncher.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
