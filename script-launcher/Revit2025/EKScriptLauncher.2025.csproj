<Project Sdk="Microsoft.NET.Sdk">
  <!-- EK Script Launcher for Revit 2025 (net8.0-windows), compiled against the Revit 2025 API. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>EK Script Launcher for Revit 2025</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.0.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
