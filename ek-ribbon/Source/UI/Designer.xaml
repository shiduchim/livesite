<Window x:Class="EKRibbon.UI.Designer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EK Ribbon Builder" Width="1100" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#DCE2E9"/>
    <SolidColorBrush x:Key="LineStrong" Color="#C3CCD6"/>
    <SolidColorBrush x:Key="Ink" Color="#1D2733"/>
    <SolidColorBrush x:Key="Muted" Color="#677485"/>
    <SolidColorBrush x:Key="Accent" Color="#1F6FB2"/>
    <SolidColorBrush x:Key="AccentDark" Color="#185A92"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E5F0FA"/>
    <SolidColorBrush x:Key="Hover" Color="#EDF1F5"/>
    <SolidColorBrush x:Key="DangerInk" Color="#C23B33"/>
    <SolidColorBrush x:Key="Warning" Color="#B26A00"/>
    <SolidColorBrush x:Key="RibbonBg" Color="#E3E7EC"/>
    <SolidColorBrush x:Key="PanelBg" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="PanelTitle" Color="#E6E9ED"/>
    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1A4F87" Offset="0"/>
      <GradientStop Color="#2675BD" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#E1E7EE"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,5"/>
    </Style>
    <Style x:Key="OnHeader" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#22FFFFFF"/>
      <Setter Property="BorderBrush" Value="#44FFFFFF"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#3DFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource DangerInk}"/>
      <Setter Property="BorderBrush" Value="#E9B9B5"/>
    </Style>
    <Style x:Key="Arrow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="2"/>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Box" Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
              <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Grid DockPanel.Dock="Right" Width="36" Height="20" Margin="12,0,0,0" VerticalAlignment="Top">
                <Border x:Name="Track" CornerRadius="10" Background="#C7CFD8"/>
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="Padding" Value="30,5,8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Box" Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#98A3B0" Margin="31,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Padding="0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MaxWidth" Value="360"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,1,7,0"/>
    </Style>
    <Style x:Key="Key" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1,1,1,2"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="MinWidth" Value="20"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Background="{StaticResource HeaderBg}" Padding="16,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image x:Name="AppIcon" Width="32" Height="32" VerticalAlignment="Center"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="EK Ribbon Builder" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="Subtitle" Foreground="#CFE2F5" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="DirtyBadge" Background="#33FFB938" BorderBrush="#88FFB938" BorderThickness="1" CornerRadius="10"
                  Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Unsaved changes" Foreground="#FFE2A8" FontSize="11.5"/>
          </Border>
          <Button x:Name="UndoButton" Style="{StaticResource OnHeader}" ToolTip="Undo (Ctrl+Z)" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;"/><TextBlock Text="Undo"/></StackPanel>
          </Button>
          <Button x:Name="RedoButton" Style="{StaticResource OnHeader}" ToolTip="Redo (Ctrl+Y)" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;"/><TextBlock Text="Redo"/></StackPanel>
          </Button>
          <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save" ToolTip="Save the layout (Ctrl+S)"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Ribbon preview -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="12,10,12,0">
      <StackPanel>
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Your EK Custom tab" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                       Text="Click a button to select it, drag it to move it, or drag commands in from the library below. Drag a button back to the library to remove it."/>
          </StackPanel>
          <Button x:Name="AddDividerButton" DockPanel.Dock="Right" VerticalAlignment="Center" ToolTip="Add a divider after the selected button (D)">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/><TextBlock Text="Divider"/></StackPanel>
          </Button>
        </DockPanel>
        <Border Background="{StaticResource RibbonBg}" CornerRadius="6" Margin="0,8,0,6" Padding="6,5">
          <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent">
            <StackPanel x:Name="PreviewHost" Orientation="Horizontal" Background="Transparent"/>
          </ScrollViewer>
        </Border>
        <WrapPanel x:Name="KeyHints"/>
      </StackPanel>
    </Border>

    <!-- Library and inspector -->
    <Grid Grid.Row="2" Margin="12,10,12,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="LibraryCard" Style="{StaticResource Card}" AllowDrop="True">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Command library" Style="{StaticResource Title}"/>
              <TextBlock x:Name="LibraryCount" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button x:Name="RescanButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                    ToolTip="Re-read every Revit tab: picks up new add-ins, changed icons and renamed commands">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/><TextBlock Text="Rescan Revit"/></StackPanel>
            </Button>
          </DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Tag="Search by name, tab or panel  (Ctrl+F)"/>
            <ComboBox x:Name="TabFilter" Grid.Column="2"/>
            <CheckBox x:Name="AddedOnly" Grid.Column="4" Style="{StaticResource Switch}" VerticalAlignment="Center">
              <TextBlock Text="On my tab"/>
            </CheckBox>
          </Grid>
          <TextBlock x:Name="LibraryStatus" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LibraryHost"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Selected" Style="{StaticResource Title}"/>

              <StackPanel x:Name="NothingSelected" Margin="0,10,0,4">
                <TextBlock Style="{StaticResource Caption}"
                           Text="Click a button in the preview to change its size, icon zoom or position. Arrow keys move it, Tab jumps to the next one."/>
              </StackPanel>

              <StackPanel x:Name="ButtonPanel" Visibility="Collapsed">
                <DockPanel Margin="0,8,0,0">
                  <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="6" Background="{StaticResource PanelBg}"
                          BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Image x:Name="SelectedIcon" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedName" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedOrigin" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="SelectedWarning" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}"
                               Margin="0,3,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </DockPanel>

                <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="SizeSmall" Style="{StaticResource Segment}" GroupName="Size" Content="Small" ToolTip="Stacked with the buttons around it (L)"/>
                  <RadioButton x:Name="SizeLarge" Style="{StaticResource Segment}" GroupName="Size" Content="Large" ToolTip="Own full-height column (L)"/>
                </StackPanel>

                <DockPanel Margin="0,10,0,4">
                  <TextBlock Text="Icon zoom" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                  <Button x:Name="ZoomReset" DockPanel.Dock="Right" Content="100%" Padding="8,2" FontSize="11" ToolTip="Reset (0)"/>
                  <TextBlock x:Name="ZoomValue" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <Border/>
                </DockPanel>
                <Slider x:Name="ZoomSlider" Minimum="50" Maximum="175" TickFrequency="5" IsSnapToTickEnabled="True"
                        SmallChange="5" LargeChange="10" ToolTip="Scale the icon inside its button (+ / -)"/>

                <TextBlock Text="Rows in this group" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Rows2" Style="{StaticResource Segment}" GroupName="Rows" Content="2 rows"/>
                  <RadioButton x:Name="Rows3" Style="{StaticResource Segment}" GroupName="Rows" Content="3 rows"/>
                </StackPanel>

                <TextBlock Text="Move" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="MoveUp" Grid.Column="1" Style="{StaticResource Arrow}" Content="&#x2191;" ToolTip="Up"/>
                    <Button x:Name="MoveLeft" Grid.Row="1" Style="{StaticResource Arrow}" Content="&#x2190;" ToolTip="Left"/>
                    <Button x:Name="MoveDown" Grid.Row="1" Grid.Column="1" Style="{StaticResource Arrow}" Content="&#x2193;" ToolTip="Down"/>
                    <Button x:Name="MoveRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource Arrow}" Content="&#x2192;" ToolTip="Right"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Caption}" Width="150" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="or use the arrow keys. Moving past the edge crosses a divider."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="DividerAfter" Content="Divider after" Margin="0,0,8,0" ToolTip="D"/>
                  <Button x:Name="RemoveButton" Style="{StaticResource Danger}" Content="Remove" ToolTip="Delete"/>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="DividerPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="Divider. Buttons after it form a new group with its own row count. Left/right arrows shift it by one button."/>
                <TextBlock Text="Rows in the group after it" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="DividerRows2" Style="{StaticResource Segment}" GroupName="DividerRows" Content="2 rows"/>
                  <RadioButton x:Name="DividerRows3" Style="{StaticResource Segment}" GroupName="DividerRows" Content="3 rows"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button x:Name="DividerLeft" Style="{StaticResource Arrow}" Content="&#x2190;" ToolTip="Shift left"/>
                  <Button x:Name="DividerRight" Style="{StaticResource Arrow}" Content="&#x2192;" ToolTip="Shift right" Margin="2,2,10,2"/>
                  <Button x:Name="RemoveDivider" Style="{StaticResource Danger}" Content="Remove divider"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Tab behaviour" Style="{StaticResource Title}"/>
              <CheckBox x:Name="PinSwitch" Style="{StaticResource Switch}" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="Keep EK Custom open" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                             Text="Revit comes back here instead of jumping to other tabs. &quot;Modify | ...&quot; tabs still open while you select or edit, and a tab you click yourself stays open. Same as the pin on the tab."/>
                </StackPanel>
              </CheckBox>
              <TextBlock Text="Tab position" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="TabPositionBox">
                <ComboBoxItem Content="Next to Modify" Tag="modify"/>
                <ComboBoxItem Content="First tab" Tag="first"/>
                <ComboBoxItem Content="Where Revit puts it" Tag="default"/>
              </ComboBox>
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Both apply right away."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Button style" Style="{StaticResource Title}"/>
              <TextBlock Text="Labels" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="LabelsBox">
                <ComboBoxItem Content="Icons only" Tag="icon"/>
                <ComboBoxItem Content="Short labels (15 characters)" Tag="short"/>
                <ComboBoxItem Content="Full labels" Tag="full"/>
              </ComboBox>
              <CheckBox x:Name="BigTwoRow" Style="{StaticResource Switch}" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="Bigger icons in 2-row groups" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Uses 32 px icons in groups set to 2 rows. Wider."/>
                </StackPanel>
              </CheckBox>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="Buttons and their style update the next time Revit starts."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,5">
      <DockPanel>
        <TextBlock x:Name="Footer" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
