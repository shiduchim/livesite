<Project Sdk="Microsoft.NET.Sdk">
  <!--
    dotnet build -c Release -p:RevitYear=2024|2025|2026|2027
    Revit API references come from the local Revit install when REVIT_INSTALL_DIR
    points at one, otherwise from the Nice3point reference packages on NuGet.
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitYear)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)' == '2025' Or '$(RevitYear)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)' == '2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>EKRibbon</AssemblyName>
    <RootNamespace>EKRibbon</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>2.0.1</Version>
    <InformationalVersion>2.0.1-revit$(RevitYear)</InformationalVersion>
    <Product>EK Ribbon Builder</Product>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <RevitApiVersion Condition="'$(RevitYear)' == '2024'">2024.0.0</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitYear)' == '2025'">2025.0.2</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitYear)' == '2026'">2026.0.4</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitYear)' == '2027'">2027.0.0</RevitApiVersion>
    <UseLocalRevit Condition="'$(REVIT_INSTALL_DIR)' != '' And Exists('$(REVIT_INSTALL_DIR)\RevitAPI.dll')">true</UseLocalRevit>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalRevit)' == 'true'">
    <Reference Include="RevitAPI" HintPath="$(REVIT_INSTALL_DIR)\RevitAPI.dll" Private="false" />
    <Reference Include="RevitAPIUI" HintPath="$(REVIT_INSTALL_DIR)\RevitAPIUI.dll" Private="false" />
    <Reference Include="AdWindows" HintPath="$(REVIT_INSTALL_DIR)\AdWindows.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRevit)' != 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
