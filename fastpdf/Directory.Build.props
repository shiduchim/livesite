<Project>
  <!-- EK FastPDF has its own build settings; this file intentionally does not import the repository root props (EK Triangle). -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <Company>EK</Company>
    <Product>EK FastPDF</Product>
    <Copyright>Copyright (c) EK</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PdfiumVersion>157.0.8100</PdfiumVersion>
  </PropertyGroup>
</Project>
