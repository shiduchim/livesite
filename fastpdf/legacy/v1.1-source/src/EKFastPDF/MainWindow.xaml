<Window x:Class="EKFastPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EKFastPDF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EK FastPDF" Width="1260" Height="790" MinWidth="800" MinHeight="510"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#EDF1F7"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#152238" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="17,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" Background="#3C68B5" CornerRadius="9" VerticalAlignment="Center">
                    <Viewbox Margin="6"><Path Fill="White" Data="M5,2 L16,2 22,8 22,26 5,26 Z M16,2 L16,8 22,8" Stretch="Uniform"/></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="EK FastPDF" FontWeight="Bold" FontSize="17" Foreground="White" />
                    <TextBlock Text="FAST · CLEAN · FOCUSED" FontSize="8.5" FontWeight="SemiBold" Foreground="#8DA7CF" />
                </StackPanel>
                <Button Grid.Column="3" Content="Open PDF" Style="{StaticResource BlueButton}" Margin="0,0,15,0" Padding="18,9" Click="Open_Click" ToolTip="Open PDFs (Ctrl+O)"/>
                <Button Grid.Column="4" Content="─" Foreground="#D5DFEF" Background="Transparent" FontSize="13" Width="41" Height="36" Style="{StaticResource PlainButton}" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button Grid.Column="5" Content="□" Foreground="#D5DFEF" Background="Transparent" FontSize="19" Width="41" Height="36" Style="{StaticResource PlainButton}" Click="Maximize_Click" ToolTip="Maximize or restore"/>
                <Button Grid.Column="6" Content="●" Foreground="#D5DFEF" Background="Transparent" FontSize="12" Width="41" Height="36" Style="{StaticResource PlainButton}" Click="CloseWindow_Click" ToolTip="Close window"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TabControl x:Name="Documents" ItemsSource="{Binding Tabs}" SelectionChanged="Documents_SelectionChanged"
                        BorderThickness="0" Background="Transparent" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#E6EBF4"/>
                        <Setter Property="Foreground" Value="#63748C"/>
                        <Setter Property="Margin" Value="0,0,5,0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabShell" Background="{TemplateBinding Background}" CornerRadius="9,9,0,0" Padding="15,8,7,7" Height="40" MinWidth="140" MaxWidth="250">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabShell" Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#24426E"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabShell" Property="Opacity" Value="0.85"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#E9EEF6" Padding="18,9,0,0">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="◯" Margin="8,0,18,5" Width="35" Height="32" Background="#D7E1F1" Foreground="#3C68B5" FontSize="19"
                                            Style="{StaticResource PlainButton}" Click="Open_Click" ToolTip="Open another PDF"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Background="White">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="115">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" ToolTip="{Binding PathName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"/>
                            <Button Grid.Column="1" Margin="9,0,0,0" Content="●" FontSize="9" Width="21" Height="21" Padding="0" Foreground="#9CAABD" Background="Transparent"
                                    Style="{StaticResource PlainButton}" Click="CloseTab_Click" ToolTip="Close this tab" Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate><local:PdfViewerControl Tab="{Binding}"/></DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <Grid x:Name="Welcome" Background="#F3F6FA" Panel.ZIndex="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <Border Width="74" Height="74" Background="#E0E9F9" CornerRadius="22" HorizontalAlignment="Center" Margin="0,0,0,23">
                        <Viewbox Margin="21"><Path Fill="#3C68B5" Data="M5,2 L16,2 22,8 22,26 5,26 Z M16,2 L16,8 22,8"/></Viewbox>
                    </Border>
                    <TextBlock Text="Your PDFs. Without the wait." FontSize="25" FontWeight="Bold" Foreground="#233047" TextAlignment="Center"/>
                    <TextBlock Text="Open a document or drop several PDF files here." FontSize="14" Foreground="#738298" Margin="0,12,0,26" TextAlignment="Center"/>
                    <Button Content="Browse PDF files" Style="{StaticResource BlueButton}" Width="190" Height="43" HorizontalAlignment="Center" Click="Open_Click"/>
                    <TextBlock Text="MULTIPLE TABS  ·  ON-DEMAND RENDERING  ·  TEXT SEARCH" Foreground="#9BA9BC" FontSize="10" Margin="0,32,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#152238">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatus" Text="Ready" VerticalAlignment="Center" Foreground="#AFC0DB" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="EK FASTPDF  1.1" VerticalAlignment="Center" Foreground="#8197B5" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
