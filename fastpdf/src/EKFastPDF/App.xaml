<Application x:Class="EKFastPDF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Palette: light theme, EK blue accent -->
        <Color x:Key="AccentColor">#3C68B5</Color>
        <SolidColorBrush x:Key="Accent" Color="#3C68B5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#335C9F"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E3EBF8"/>
        <SolidColorBrush x:Key="Ink" Color="#1F2A3C"/>
        <SolidColorBrush x:Key="InkSoft" Color="#5E6B80"/>
        <SolidColorBrush x:Key="InkFaint" Color="#8F9BAE"/>
        <SolidColorBrush x:Key="Chrome" Color="#E9EEF5"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#DCE3EE"/>
        <SolidColorBrush x:Key="Hover" Color="#EDF1F7"/>
        <SolidColorBrush x:Key="Pressed" Color="#DFE6F1"/>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Icons (24x24 stroke geometry; deliberately no plus or X shapes) -->
        <Geometry x:Key="IconOpen">M3,7 C3,5.9 3.9,5 5,5 L9.6,5 L11.6,7 L19,7 C20.1,7 21,7.9 21,9 L21,17.5 C21,18.6 20.1,19.5 19,19.5 L5,19.5 C3.9,19.5 3,18.6 3,17.5 Z</Geometry>
        <Geometry x:Key="IconPrint">M7,9 L7,4 L17,4 L17,9 M7,17 L4.8,17 C4.4,17 4,16.6 4,16.2 L4,10.8 C4,9.8 4.8,9 5.8,9 L18.2,9 C19.2,9 20,9.8 20,10.8 L20,16.2 C20,16.6 19.6,17 19.2,17 L17,17 M7,14 L17,14 L17,20 L7,20 Z</Geometry>
        <Geometry x:Key="IconLeft">M14.5,6 L8.5,12 L14.5,18</Geometry>
        <Geometry x:Key="IconRight">M9.5,6 L15.5,12 L9.5,18</Geometry>
        <Geometry x:Key="IconUp">M6,14.5 L12,8.5 L18,14.5</Geometry>
        <Geometry x:Key="IconDown">M6,9.5 L12,15.5 L18,9.5</Geometry>
        <Geometry x:Key="IconZoomOut">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.3,15.3 L20,20 M7.8,10.5 L13.2,10.5</Geometry>
        <Geometry x:Key="IconZoomIn">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.3,15.3 L20,20 M7.9,11.8 L10.5,9.2 L13.1,11.8</Geometry>
        <Geometry x:Key="IconFitPage">M4,8.5 L4,4 L8.5,4 M15.5,4 L20,4 L20,8.5 M20,15.5 L20,20 L15.5,20 M8.5,20 L4,20 L4,15.5 M8,7.5 L16,7.5 L16,16.5 L8,16.5 Z</Geometry>
        <Geometry x:Key="IconFitWidth">M4,5 L4,19 M20,5 L20,19 M7.5,12 L16.5,12 M10,9.5 L7.5,12 L10,14.5 M14,9.5 L16.5,12 L14,14.5</Geometry>
        <Geometry x:Key="IconSearch">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.3,15.3 L20,20</Geometry>
        <Geometry x:Key="IconMore">M5,12 A1.5,1.5 0 1 1 5,12.01 M12,12 A1.5,1.5 0 1 1 12,12.01 M19,12 A1.5,1.5 0 1 1 19,12.01</Geometry>
        <Geometry x:Key="IconDoc">M6,3 L14,3 L19,8 L19,21 L6,21 Z M14,3 L14,8 L19,8</Geometry>
        <Geometry x:Key="IconRing">M12,6 A6,6 0 1 1 11.99,6 Z</Geometry>
        <Geometry x:Key="IconMinimize">M6,12 L18,12</Geometry>
        <Geometry x:Key="IconMaximize">M6.5,6.5 L17.5,6.5 L17.5,17.5 L6.5,17.5 Z</Geometry>
        <Geometry x:Key="IconRestore">M8.5,8.5 L17.5,8.5 L17.5,17.5 L8.5,17.5 Z M6.5,15.5 L6.5,6.5 L15.5,6.5</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#3A475C"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource Pressed}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="Double.NaN"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DCE3EE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#CFD8E6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#F4F6FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26344A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
