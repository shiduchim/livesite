<Window x:Class="EKFastPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:EKFastPDF.Viewer"
        Title="EKPDF" Width="1320" Height="840" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Chrome}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" StateChanged="Window_StateChanged"
        Icon="Assets/FastPDF.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: logo, tabs, Open; in Compact also the page and zoom tools. No + or x controls. -->
        <Grid Grid.Row="0" Background="{DynamicResource Chrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Home panel (docs mockup A): the EKPDF logo and My PDFs on their own full-height panel,
                 a line after it, and a blue line under it while My PDFs is showing. Not a tab. -->
            <Border x:Name="LibraryTab" Grid.Column="0" Padding="10,0,14,0" Margin="0,0,6,0" BorderThickness="0,0,1,0"
                    Background="{DynamicResource HomeBack}" BorderBrush="{DynamicResource Line}"
                    Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="LibraryTab_Click"
                    MouseEnter="LibraryTab_Hover" MouseLeave="LibraryTab_Hover" ToolTip="My PDFs: your PDF folders">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/EKPDF-64.png" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="LibraryTabText" Text="My PDFs" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                    </StackPanel>
                    <Border x:Name="LibraryActiveLine" Height="2" VerticalAlignment="Bottom" Margin="-10,0,-14,0" Background="{DynamicResource Accent}"/>
                </Grid>
            </Border>
            <DockPanel Grid.Column="1" LastChildFill="False" VerticalAlignment="Center">
                <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left" WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewer:DocumentSession}">
                            <Border x:Name="Tab" Height="26" MinWidth="90" MaxWidth="220" Margin="0,0,2,0" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"
                                    Background="Transparent" Cursor="Hand" ToolTip="{Binding FilePath}"
                                    MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp" MouseRightButtonUp="Tab_RightClick" Tag="{Binding}">
                                <Grid Margin="10,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Busy" Grid.Column="0" Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource Accent}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Caption" Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource InkSoft}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <!-- Close: a small circle (middle-click, Ctrl+W and right-click also close). -->
                                    <Button x:Name="CloseTab" Grid.Column="2" Width="18" Height="18" Margin="4,0,0,0" Style="{StaticResource IconButton}"
                                            Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab (Ctrl+W)" Visibility="Hidden">
                                        <Path Data="{StaticResource IconRing}" Style="{StaticResource IconPath}" Width="9" Height="9" StrokeThickness="1.6"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Surface}"/>
                                    <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource TabBorder}"/>
                                    <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Ink}"/>
                                    <Setter TargetName="CloseTab" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Opening">
                                    <Setter TargetName="Busy" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseTab" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <StackPanel x:Name="TitleTools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <ContentControl x:Name="TitleNavHost" Focusable="False"/>
                <Button x:Name="SearchToggle" Style="{StaticResource IconButton}" Width="26" Height="26" Click="SearchToggle_Click" ToolTip="Search (Ctrl+F)">
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                </Button>
                <ContentControl x:Name="TitleMoreHost" Focusable="False"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximize / restore">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Width="Auto" Padding="12,0" Click="CloseWindow_Click" ToolTip="Close EKPDF">
                    <TextBlock Text="Close" FontSize="11.5" Foreground="{DynamicResource InkSoft}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Regular layout only: the toolbar. -->
        <Border x:Name="ToolbarRow" Grid.Row="1" Height="40" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrintButton" Style="{StaticResource IconButton}" Click="Print_Click" ToolTip="Print (Ctrl+P)">
                        <Path Data="{StaticResource IconPrint}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Border Style="{StaticResource Divider}"/>
                    <ContentControl x:Name="ToolbarNavHost" Focusable="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl x:Name="ToolbarSearchHost" Focusable="False"/>
                    <ContentControl x:Name="ToolbarMoreHost" Focusable="False" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shared tools, placed by ApplyLayout in the title bar (Compact) or the toolbar (Regular). -->
        <Grid x:Name="ToolHolder" Visibility="Collapsed">
            <StackPanel x:Name="NavTools" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevPageButton" Style="{StaticResource IconButton}" Width="26" Height="26" Click="PrevPage_Click" ToolTip="Previous page (Page Up)">
                    <Path Data="{StaticResource IconLeft}" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                </Button>
                <TextBox x:Name="PageBox" Style="{StaticResource FieldBox}" Width="40" TextAlignment="Center" Margin="2,0"
                         PreviewKeyDown="PageBox_PreviewKeyDown" GotKeyboardFocus="SelectAllOnFocus" ToolTip="Go to page"/>
                <TextBlock x:Name="PageCountText" Style="{StaticResource BarText}" Text="/ –" Margin="3,0,2,0" MinWidth="28"/>
                <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" Width="26" Height="26" Click="NextPage_Click" ToolTip="Next page (Page Down)">
                    <Path Data="{StaticResource IconRight}" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                </Button>
                <Border Style="{StaticResource Divider}"/>
                <Grid>
                    <TextBox x:Name="ZoomBox" Style="{StaticResource FieldBox}" Width="84" MinWidth="84" TextAlignment="Center" Padding="2,0,20,0" HorizontalScrollBarVisibility="Hidden"
                             PreviewKeyDown="ZoomBox_PreviewKeyDown" GotKeyboardFocus="SelectAllOnFocus" ToolTip="Zoom (type a percentage; Ctrl+wheel)"/>
                    <Button HorizontalAlignment="Right" Width="20" Height="22" Margin="0,0,1,0" Style="{StaticResource IconButton}" Click="ZoomMenu_Click" ToolTip="Zoom in, zoom out, fit and sizes">
                        <Path Data="{StaticResource IconDown}" Style="{StaticResource IconPath}" Width="9" Height="9"/>
                    </Button>
                </Grid>
                <Button x:Name="FitPageButton" Style="{StaticResource IconButton}" Click="FitPage_Click" ToolTip="Fit page (Ctrl+0)" Margin="4,0,0,0">
                    <Path Data="{StaticResource IconFitPage}" Style="{StaticResource IconPath}"/>
                </Button>
                <Button x:Name="FitWidthButton" Style="{StaticResource IconButton}" Click="FitWidth_Click" ToolTip="Fit width (Ctrl+2)">
                    <Path Data="{StaticResource IconFitWidth}" Style="{StaticResource IconPath}"/>
                </Button>
                <Border x:Name="Box3DDivider" Style="{StaticResource Divider}"/>
                <Button x:Name="Box3DButton" Style="{StaticResource SoftButton}" Tag="Accent" Click="Box3D_Click" ToolTip="Open a spot of the plan in 3D" Visibility="Collapsed"/>
            </StackPanel>
            <Border x:Name="SearchField" CornerRadius="4" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" Height="24" Width="230">
                <Grid Margin="7,0,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource InkFaint}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" StrokeEndLineCap="Round"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="12" Margin="5,0,0,0"
                             Foreground="{DynamicResource Ink}" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Search text (Ctrl+F; Enter for next, Esc to close)"/>
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search" Margin="7,0,0,0" IsHitTestVisible="False" Style="{StaticResource BarText}" Foreground="{DynamicResource InkFaint}"/>
                    <TextBlock x:Name="SearchCounter" Grid.Column="2" Style="{StaticResource BarText}" FontSize="11" Margin="4,0,2,0"/>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="20" Height="20" Click="PrevResult_Click" ToolTip="Previous result (Shift+F3)">
                        <Path Data="{StaticResource IconUp}" Style="{StaticResource IconPath}" Width="11" Height="11"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="20" Height="20" Click="NextResult_Click" ToolTip="Next result (F3)">
                        <Path Data="{StaticResource IconDown}" Style="{StaticResource IconPath}" Width="11" Height="11"/>
                    </Button>
                </Grid>
            </Border>
            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Width="26" Height="26" Click="More_Click" ToolTip="Layout, mouse wheel, print and more">
                <Path Data="{StaticResource IconMore}" Style="{StaticResource IconPath}" StrokeThickness="2.4" Width="14" Height="14"/>
            </Button>
        </Grid>

        <!-- Document area -->
        <Grid Grid.Row="2" Background="{DynamicResource DocBackground}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition x:Name="BoxDividerColumn" Width="0"/><ColumnDefinition x:Name="BoxColumn" Width="0"/></Grid.ColumnDefinitions>
            <GridSplitter x:Name="BoxDivider" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Splitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" ToolTip="Drag to resize the 3D view"/>
            <ContentControl x:Name="BoxHost" Grid.Column="2"/>

            <viewer:PdfViewport x:Name="Viewport"/>
            <!-- Scroll bars over the page view (they move the view; the view stays custom drawn). -->
            <ScrollBar x:Name="VScroll" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,0,16" Style="{StaticResource PdfScrollBar}" Scroll="VScroll_Scroll" Visibility="Collapsed"/>
            <ScrollBar x:Name="HScroll" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,0" Style="{StaticResource PdfScrollBar}" Scroll="HScroll_Scroll" Visibility="Collapsed"/>

            <Grid x:Name="StatePanel" Background="{DynamicResource DocBackground}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <ProgressBar x:Name="StateProgress" IsIndeterminate="True" Height="3" Width="140" Foreground="{DynamicResource Accent}" Background="{DynamicResource Splitter}" BorderThickness="0" Margin="0,0,0,22"/>
                    <TextBlock x:Name="StateTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StateDetail" FontSize="12.5" Foreground="{DynamicResource InkSoft}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel x:Name="PasswordPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
                        <PasswordBox x:Name="PasswordInput" Width="200" Height="32" VerticalContentAlignment="Center" Padding="6,0" KeyDown="PasswordInput_KeyDown"/>
                        <Button Content="Open" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="16,6" Click="Unlock_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Compact layout: search opens here (Ctrl+F or the search button). -->
            <Border x:Name="SearchOverlay" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Padding="4" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                <ContentControl x:Name="SearchOverlayHost" Focusable="False"/>
            </Border>
            <!-- Compact layout: messages appear briefly instead of the status bar. -->
            <Border x:Name="Toast" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Padding="8,3" Background="{DynamicResource ToastBack}" BorderBrush="{DynamicResource TabBorder}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="640">
                <TextBlock x:Name="ToastText" Style="{StaticResource BarText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- My PDFs (Viewer/LibraryView.cs); shown while its tab is selected. -->
            <ContentControl x:Name="LibraryHost" Grid.ColumnSpan="3" Focusable="False"/>
        </Grid>

        <!-- Regular layout only: the status bar. -->
        <Border x:Name="StatusRow" Grid.Row="3" Height="22" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource BarText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Ellipse x:Name="SharpDot" Width="6" Height="6" Fill="{DynamicResource InkFaint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="RenderText" Style="{StaticResource BarText}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
