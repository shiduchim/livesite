<Window x:Class="EKFastPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:EKFastPDF.Viewer"
        Title="Offline 3D PDF Viewer v0.5.0" Width="1320" Height="840" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Chrome}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" StateChanged="Window_StateChanged"
        Icon="Assets/FastPDF.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Title bar with document tabs -->
        <Grid Grid.Row="0" Background="{StaticResource Chrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="26" Height="26" Margin="12,0,10,0" CornerRadius="7" Background="{StaticResource Accent}" VerticalAlignment="Center" ToolTip="EK FastPDF">
                <Path Data="{StaticResource IconDoc}" Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
            </Border>
            <DockPanel Grid.Column="1" LastChildFill="False" Margin="0,6,0,0">
                <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left" WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewer:DocumentSession}">
                            <Border x:Name="Tab" Height="36" MinWidth="120" MaxWidth="240" Margin="0,0,3,0" CornerRadius="9,9,0,0"
                                    Background="Transparent" Cursor="Hand" ToolTip="{Binding FilePath}"
                                    MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp" Tag="{Binding}">
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Busy" Grid.Column="0" Width="6" Height="6" Margin="0,0,7,0" Fill="{StaticResource Accent}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Caption" Grid.Column="1" Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource InkSoft}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button x:Name="CloseTab" Grid.Column="2" Width="22" Height="22" Margin="6,0,0,0" Style="{StaticResource IconButton}"
                                            Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab (Ctrl+W)" Opacity="0.55">
                                        <Path Data="{StaticResource IconRing}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.8"/>
                                    </Button>
                                    <Border x:Name="Underline" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Margin="-6,0,-2,0" CornerRadius="1" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="White"/>
                                    <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Ink}"/>
                                    <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CloseTab" Property="Opacity" Value="0.9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Opening">
                                    <Setter TargetName="Busy" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseTab" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="4,0,0,4" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Open_Click" ToolTip="Open PDF in a new tab (Ctrl+O)">
                    <Path Data="{StaticResource IconOpen}" Style="{StaticResource IconPath}" Width="16" Height="16"/>
                </Button>
            </DockPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" Width="12" Height="12" StrokeThickness="1.3"/>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximize / restore">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}" Width="12" Height="12" StrokeThickness="1.3"/>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="CloseWindow_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconRing}" Style="{StaticResource IconPath}" Width="12" Height="12" StrokeThickness="1.4"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="Open_Click" ToolTip="Open (Ctrl+O)">
                        <Path Data="{StaticResource IconOpen}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Button x:Name="Box3DButton" Content="3D box" Padding="10,5" Margin="4,0" Click="Box3D_Click" ToolTip="Offline 3D PDF v0.5.0 — activate the 3D box"/>
                    <Button x:Name="PrintButton" Style="{StaticResource IconButton}" Click="Print_Click" ToolTip="Print (Ctrl+P)">
                        <Path Data="{StaticResource IconPrint}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Border Style="{StaticResource Divider}"/>
                    <Button x:Name="PrevPageButton" Style="{StaticResource IconButton}" Click="PrevPage_Click" ToolTip="Previous page (Page Up)">
                        <Path Data="{StaticResource IconLeft}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <TextBox x:Name="PageBox" Style="{StaticResource FieldBox}" Width="52" TextAlignment="Center" Margin="2,0" FontWeight="SemiBold"
                             PreviewKeyDown="PageBox_PreviewKeyDown" GotKeyboardFocus="SelectAllOnFocus" ToolTip="Go to page"/>
                    <TextBlock x:Name="PageCountText" Style="{StaticResource BarText}" Text="/ –" Margin="4,0,2,0" MinWidth="34"/>
                    <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" Click="NextPage_Click" ToolTip="Next page (Page Down)">
                        <Path Data="{StaticResource IconRight}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Border Style="{StaticResource Divider}"/>
                    <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+−)">
                        <Path Data="{StaticResource IconZoomOut}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Grid Margin="2,0">
                        <TextBox x:Name="ZoomBox" Style="{StaticResource FieldBox}" Width="74" TextAlignment="Center" Padding="4,0,18,0"
                                 PreviewKeyDown="ZoomBox_PreviewKeyDown" GotKeyboardFocus="SelectAllOnFocus" ToolTip="Zoom (type a percentage)"/>
                        <Button HorizontalAlignment="Right" Width="20" Height="26" Margin="0,0,2,0" Style="{StaticResource IconButton}" Click="ZoomMenu_Click" ToolTip="Zoom presets">
                            <Path Data="{StaticResource IconDown}" Style="{StaticResource IconPath}" Width="10" Height="10"/>
                        </Button>
                    </Grid>
                    <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+=, Ctrl+wheel)">
                        <Path Data="{StaticResource IconZoomIn}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="FitPage_Click" ToolTip="Fit page (Ctrl+0)" Margin="4,0,0,0">
                        <Path Data="{StaticResource IconFitPage}" Style="{StaticResource IconPath}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="FitWidth_Click" ToolTip="Fit width (Ctrl+2)">
                        <Path Data="{StaticResource IconFitWidth}" Style="{StaticResource IconPath}"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#F4F6FA" BorderBrush="{StaticResource Line}" BorderThickness="1" Height="32" Width="300">
                        <Grid Margin="8,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource InkFaint}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" StrokeEndLineCap="Round"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="13" Margin="6,0,0,0"
                                     Foreground="{StaticResource Ink}" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Search text (Ctrl+F, Enter for next)"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search" Margin="8,0,0,0" IsHitTestVisible="False" Style="{StaticResource BarText}" Foreground="{StaticResource InkFaint}"/>
                            <TextBlock x:Name="SearchCounter" Grid.Column="2" Style="{StaticResource BarText}" FontSize="11.5" Margin="4,0,4,0"/>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26" Click="PrevResult_Click" ToolTip="Previous result (Shift+F3)">
                                <Path Data="{StaticResource IconUp}" Style="{StaticResource IconPath}" Width="13" Height="13"/>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26" Click="NextResult_Click" ToolTip="Next result (F3)">
                                <Path Data="{StaticResource IconDown}" Style="{StaticResource IconPath}" Width="13" Height="13"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="More_Click" ToolTip="More">
                        <Path Data="{StaticResource IconMore}" Style="{StaticResource IconPath}" StrokeThickness="2.6"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document area -->
        <Grid Grid.Row="2" Background="#E6EBF3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition x:Name="BoxDividerColumn" Width="0"/><ColumnDefinition x:Name="BoxColumn" Width="0"/></Grid.ColumnDefinitions>
            <GridSplitter x:Name="BoxDivider" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CFD9E6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" ToolTip="Drag to resize the 3D view"/>
            <ContentControl x:Name="BoxHost" Grid.Column="2"/>

            <viewer:PdfViewport x:Name="Viewport"/>

            <Grid x:Name="StatePanel" Background="#EEF2F8" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <ProgressBar x:Name="StateProgress" IsIndeterminate="True" Height="3" Width="140" Foreground="{StaticResource Accent}" Background="#DAE3F1" BorderThickness="0" Margin="0,0,0,22"/>
                    <TextBlock x:Name="StateTitle" FontSize="17" FontWeight="SemiBold" Foreground="#3B4B63" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StateDetail" FontSize="12.5" Foreground="{StaticResource InkSoft}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel x:Name="PasswordPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
                        <PasswordBox x:Name="PasswordInput" Width="200" Height="32" VerticalContentAlignment="Center" Padding="6,0" KeyDown="PasswordInput_KeyDown"/>
                        <Button Content="Open" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="16,6" Click="Unlock_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="Welcome" Background="#F2F5FA">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                    <Border Width="72" Height="72" Background="{StaticResource AccentSoft}" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Path Data="{StaticResource IconDoc}" Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="32" Height="32" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Large drawings. No waiting." FontSize="25" FontWeight="Bold" Foreground="{StaticResource Ink}" TextAlignment="Center"/>
                    <TextBlock Text="Open a PDF or drop files anywhere in this window." FontSize="14" Foreground="{StaticResource InkSoft}" Margin="0,10,0,24" TextAlignment="Center"/>
                    <Button Content="Open PDF files" Style="{StaticResource AccentButton}" Width="180" HorizontalAlignment="Center" Click="Open_Click"/>
                    <TextBlock x:Name="WelcomeInfo" Foreground="{StaticResource InkFaint}" FontSize="11" Margin="0,30,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource BarText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                    <Ellipse x:Name="SharpDot" Width="7" Height="7" Fill="#9AA7BA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="RenderText" Style="{StaticResource BarText}" FontSize="11.5"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="EK FastPDF 1.2" Style="{StaticResource BarText}" FontSize="11" Foreground="{StaticResource InkFaint}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
